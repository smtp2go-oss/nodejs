{
  "name": "smtp2go-nodejs",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "NodeJS Library for interacting with the SMTP2GO API",
  "main": "./build/index.js",
  "types": "./build/src/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/lib/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "start": "webpack serve --config webpack.config.demo.js",
    "build": "webpack && tsc",
    "watch": "webpack && tsc --watch",
    "bundleup": "webpack-cli",
    "build:demo": "webpack --config webpack.config.demo.js",
    "test": "jest",
    "coverage": "npm run test -- --coverage",
    "prepare": "npm run build",
    "publishdev": "npm publish --tag dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smtp2go-oss/nodejs.git"
  },
  "author": "SMTP2GO <hello@smtp2go.com> (https://github.com/smtp2go-oss)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smtp2go-oss/nodejs/issues"
  },
  "homepage": "https://github.com/smtp2go-oss/nodejs",
  "keywords": [
    "smtp",
    "mail",
    "api"
  ],
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.0.0",
    "babel-preset-minify": "^0.5.2",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.34.0",
    "file-loader": "^6.2.0",
    "jest": "^30.1.3",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "url-loader": "^4.1.1",
    "vite": "^7.1.5",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/runtime": "^7.28.3",
    "axios": "^1.11.0",
    "mime-types": "^3.0.1"
  },
  "np": {
    "yarn": false,
    "contents": "build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
